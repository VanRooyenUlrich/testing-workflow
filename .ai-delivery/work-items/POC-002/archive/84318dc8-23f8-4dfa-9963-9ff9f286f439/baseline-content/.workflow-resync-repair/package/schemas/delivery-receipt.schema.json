{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ai-delivery/delivery-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "workItem", "project", "sessionId", "snapshotHash", "confirmationHash", "targetRoot", "changeHash", "noChange", "appliedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transactionId": { "type": "string", "minLength": 1 },
    "workItem": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "snapshotHash": { "$ref": "#/$defs/hash" },
    "confirmationHash": { "$ref": "#/$defs/hash" },
    "targetRoot": { "type": "string", "minLength": 1 },
    "changeHash": { "$ref": "#/$defs/hash" },
    "noChange": { "type": "boolean" },
    "appliedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
