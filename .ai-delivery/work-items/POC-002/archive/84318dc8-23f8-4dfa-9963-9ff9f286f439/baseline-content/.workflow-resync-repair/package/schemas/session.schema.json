{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ai-delivery/session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "id", "workItem", "project", "repository", "hostRoot", "workspace", "baselineContentRoot", "mode", "governanceHash", "registryHash", "manifestHash", "manifest", "baseline", "expectedHost", "expectedWorkspace", "artifactsHash", "role", "epoch", "lifecycleState", "issuedAt", "expiresAt", "grants", "closed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "id": { "type": "string", "minLength": 1 },
    "workItem": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "hostRoot": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "baselineContentRoot": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["HOST_WORKSPACE", "ISOLATED_WORKTREE", "ISOLATED_ENVIRONMENT"] },
    "governanceHash": { "$ref": "#/$defs/hash" },
    "registryHash": { "$ref": "#/$defs/hash" },
    "manifestHash": { "$ref": "#/$defs/hash" },
    "manifest": { "$ref": "capability-manifest.schema.json" },
    "baseline": { "$ref": "#/$defs/snapshot" },
    "sourceBaseline": { "$ref": "#/$defs/snapshot" },
    "expectedHost": { "$ref": "#/$defs/snapshot" },
    "expectedWorkspace": { "$ref": "#/$defs/snapshot" },
    "artifactsHash": { "$ref": "#/$defs/hash" },
    "approvalContextHash": { "$ref": "#/$defs/hash" },
    "baselineCommit": { "type": "string", "minLength": 1 },
    "role": { "enum": ["discovery", "specification", "planning", "implementation", "validation", "review"] },
    "epoch": { "type": "integer", "minimum": 1 },
    "lifecycleState": { "enum": ["DISCOVERING", "SPEC_DRAFT", "SPEC_ACCEPTED", "PLANNING", "PLAN_APPROVED", "IMPLEMENTING", "VALIDATING", "READY_FOR_REVIEW", "COMPLETE"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revokedAt": { "type": "string", "format": "date-time" },
    "revokedReason": { "type": "string", "minLength": 1 },
    "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } },
    "validation": { "$ref": "#/$defs/validation" },
    "handoff": { "$ref": "#/$defs/handoff" },
    "reviewSubmission": { "$ref": "#/$defs/reviewSubmission" },
    "review": { "$ref": "#/$defs/review" },
    "promotion": { "$ref": "#/$defs/promotion" },
    "closed": { "type": "boolean" },
    "runtime": { "const": "CONTAINER" },
    "reviewOf": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["sha256", "size"], "properties": { "sha256": { "$ref": "#/$defs/hash" }, "size": { "type": "integer", "minimum": 0 } } },
    "snapshot": { "type": "object", "additionalProperties": { "$ref": "#/$defs/file" } },
    "grant": { "type": "object", "additionalProperties": false, "required": ["path", "expiresAt", "reason", "actor"], "properties": { "path": { "type": "string", "minLength": 1 }, "expiresAt": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "minLength": 1 }, "actor": { "type": "string", "minLength": 1 } } },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["id", "command", "status", "exitCode", "definitionHash", "outputHash", "logHash", "logPath", "startedAt", "completedAt", "sessionId", "snapshotHash", "governanceHash", "manifestHash"], "properties": { "id": { "type": "string", "minLength": 1 }, "command": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASSED", "FAILED", "TIMED_OUT", "CANCELLED"] }, "exitCode": { "type": ["integer", "null"] }, "definitionHash": { "$ref": "#/$defs/hash" }, "outputHash": { "$ref": "#/$defs/hash" }, "logHash": { "$ref": "#/$defs/hash" }, "logPath": { "type": "string", "pattern": "^logs/[A-Za-z0-9_.-]+\\.log$" }, "startedAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": "string", "format": "date-time" }, "sessionId": { "type": "string", "minLength": 1 }, "snapshotHash": { "$ref": "#/$defs/hash" }, "governanceHash": { "$ref": "#/$defs/hash" }, "manifestHash": { "$ref": "#/$defs/hash" } } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["snapshotHash", "governanceHash", "passed", "commands"], "properties": { "snapshotHash": { "$ref": "#/$defs/hash" }, "governanceHash": { "$ref": "#/$defs/hash" }, "passed": { "type": "boolean" }, "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "changedPaths": { "type": "array", "items": { "type": "string" } }, "commandResults": { "type": "array", "items": { "$ref": "#/$defs/receipt" } }, "resultHash": { "$ref": "#/$defs/hash" }, "validatedAt": { "type": "string", "format": "date-time" } } },
    "handoff": { "type": "object", "additionalProperties": false, "required": ["contentHash", "snapshotHash", "governanceHash", "manifestHash", "submittedAt"], "properties": { "contentHash": { "$ref": "#/$defs/hash" }, "snapshotHash": { "$ref": "#/$defs/hash" }, "governanceHash": { "$ref": "#/$defs/hash" }, "manifestHash": { "$ref": "#/$defs/hash" }, "submittedAt": { "type": "string", "format": "date-time" } } },
    "reviewSubmission": { "type": "object", "additionalProperties": false, "required": ["sourceSession", "snapshotHash", "governanceHash", "manifestHash", "findingsHash", "outcome", "submittedAt", "confirmationHash"], "properties": { "sourceSession": { "type": "string", "minLength": 1 }, "snapshotHash": { "$ref": "#/$defs/hash" }, "governanceHash": { "$ref": "#/$defs/hash" }, "manifestHash": { "$ref": "#/$defs/hash" }, "findingsHash": { "$ref": "#/$defs/hash" }, "handoffHash": { "$ref": "#/$defs/hash" }, "outcome": { "enum": ["APPROVED", "CHANGES_REQUESTED"] }, "submittedAt": { "type": "string", "format": "date-time" }, "confirmationHash": { "$ref": "#/$defs/hash" } } },
    "review": { "type": "object", "additionalProperties": false, "required": ["snapshotHash", "reviewer", "reviewSessionId", "findingsHash", "approved", "humanReviewed", "confirmationHash"], "properties": { "snapshotHash": { "$ref": "#/$defs/hash" }, "reviewer": { "type": "string", "minLength": 1 }, "reviewSessionId": { "type": "string", "minLength": 1 }, "findingsHash": { "$ref": "#/$defs/hash" }, "handoffHash": { "$ref": "#/$defs/hash" }, "approved": { "type": "boolean" }, "humanReviewed": { "type": "boolean" }, "confirmationHash": { "$ref": "#/$defs/hash" } } },
    "promotion": { "type": "object", "additionalProperties": false, "required": ["confirmationHash", "applied"], "properties": { "confirmationHash": { "$ref": "#/$defs/hash" }, "applied": { "type": "boolean" }, "receiptHash": { "$ref": "#/$defs/hash" }, "transactionId": { "type": "string", "minLength": 1 }, "snapshotHash": { "$ref": "#/$defs/hash" }, "appliedAt": { "type": "string", "format": "date-time" } } }
  }
}
