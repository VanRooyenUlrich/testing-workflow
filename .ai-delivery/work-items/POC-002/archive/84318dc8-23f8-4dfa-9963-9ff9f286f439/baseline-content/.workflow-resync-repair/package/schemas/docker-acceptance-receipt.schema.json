{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ai-delivery/docker-acceptance-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "head", "completedAt", "docker", "images", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 }, "status": { "const": "PASS" },
    "head": { "type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$" },
    "completedAt": { "type": "string", "format": "date-time" }, "docker": { "type": "string", "pattern": "^linux/" },
    "images": {
      "type": "object", "additionalProperties": false, "required": ["generic", "codex", "claude", "copilot"],
      "properties": {
        "generic": { "$ref": "#/$defs/image" }, "codex": { "$ref": "#/$defs/image" },
        "claude": { "$ref": "#/$defs/image" }, "copilot": { "$ref": "#/$defs/image" }
      }
    },
    "checks": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "image": {
      "type": "object", "additionalProperties": false, "required": ["reference", "localId"],
      "properties": { "reference": { "type": "string", "minLength": 1 }, "localId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "outputHash"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "status": { "const": "PASS" }, "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  }
}
