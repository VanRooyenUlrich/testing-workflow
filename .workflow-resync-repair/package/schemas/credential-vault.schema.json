{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ai-delivery/credential-vault.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": { "type": "object", "additionalProperties": false, "properties": { "codex": { "$ref": "#/$defs/entry" }, "claude": { "$ref": "#/$defs/entry" } } }
  },
  "$defs": { "entry": { "type": "object", "additionalProperties": false, "required": ["protectedValue", "updatedAt"], "properties": { "protectedValue": { "type": "string", "minLength": 1 }, "updatedAt": { "type": "string", "format": "date-time" } } } }
}
