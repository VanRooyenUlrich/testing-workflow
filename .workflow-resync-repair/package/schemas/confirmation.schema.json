{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runninghill.example/ai-delivery/confirmation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["workItemId", "action", "project", "riskProfile", "timestamp", "localOsUser", "stale"],
  "properties": {
    "workItemId": { "type": "string" }, "action": { "type": "string" }, "project": { "type": "string" },
    "riskProfile": { "enum": ["LIGHTWEIGHT", "STANDARD", "HIGH_RISK"] },
    "artifactType": { "enum": ["discovery", "specification", "architecture-impact", "plan", "review"] },
    "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }, "localOsUser": { "type": "string", "minLength": 1 },
    "reason": { "type": "string" }, "stale": { "type": "boolean" }, "staleReason": { "type": "string" }
  }
}
