{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "node \"node_modules/ai-delivery-workflow/dist/src/cli/main.js\" hook pre --session-env",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node \"node_modules/ai-delivery-workflow/dist/src/cli/main.js\" hook post --session-env",
        "timeout": 15
      }
    ]
  }
}
